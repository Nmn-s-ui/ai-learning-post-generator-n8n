    {
      "parameters": {
        "jsCode": "\nconst text = $json.text || \"\";\nconst metaIdx = text.indexOf(\"===META===\");\nconst artIdx = text.indexOf(\"===ARTICLE===\");\nif (metaIdx === -1 || artIdx === -1) {\n  throw new Error(\"Model output is missing the ===META=== or ===ARTICLE=== section.\");\n}\n\nconst metaText = text.slice(metaIdx + 10, artIdx);\nconst first = metaText.indexOf(\"{\");\nconst last = metaText.lastIndexOf(\"}\");\nif (first === -1 || last === -1) {\n  throw new Error(\"Could not find the JSON metadata block.\");\n}\nconst meta = JSON.parse(metaText.slice(first, last + 1));\n\nconst fence = String.fromCharCode(96, 96, 96);\nlet content = text.slice(artIdx + 13).split(fence + \"html\").join(\"\").split(fence).join(\"\").trim();\n\n// Drop any stray marker the model repeats at the end of the article.\nconst strayIdx = content.indexOf(\"===\");\nif (strayIdx !== -1) {\n  content = content.slice(0, strayIdx).trim();\n}\n\n// [IMAGE_1] / [IMAGE_2] markers are replaced in the Publish to Blogger node.\n\nconst wordCount = content.replace(/<[^>]*>/g, \" \").split(/\\s+/).filter(Boolean).length;\nif (!meta.title || !content) {\n  throw new Error(\"Title or article HTML is missing.\");\n}\nif (wordCount < 1000) {\n  throw new Error(\"Article is too short (\" + wordCount + \" words). Stopping before publishing.\");\n}\n\nreturn [{\n  json: {\n    title: meta.title,\n    description: meta.description || \"\",\n    labels: meta.labels || [],\n    keywords: meta.keywords || [],\n    imageAlt: meta.image_alt || \"\",\n    imagePrompt: meta.image_prompt || (\"Editorial illustration for a blog post about \" + meta.title + \", no text, no logos\"),\n    content,\n    wordCount\n  }\n}];\n"
      },
