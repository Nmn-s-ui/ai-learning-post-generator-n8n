    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst product = rows.find(r => r.title && r.affiliate_link && (!r.posted || String(r.posted).trim() === ''));\nif (!product) { return []; }\n\nconst prompt = `Write Pinterest pin copy for this product.\\n\\nProduct: ${product.title}\\nCategory: ${product.category}\\n\\nRules:\\n- Title: max 100 characters, include a searchable keyword people would type into Pinterest.\\n- Description: 2-3 sentences, max 400 characters, natural tone, benefit-focused, end with a short call to action.\\n- Add 3-5 relevant hashtags at the end of the description.\\n- Do not invent specs, prices, discounts, or reviews.\\n\\nReturn ONLY JSON: {\"title\": \"...\", \"description\": \"...\", \"alt_text\": \"...\"}`;\n\nreturn [{\n  json: {\n    ...product,\n    geminiBody: {\n      contents: [{ parts: [{ text: prompt }] }],\n      generationConfig: { responseMimeType: 'application/json', temperature: 0.8 }\n    }\n  }\n}];"
      },
      "name": "Pick Next Product",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        -416
      ],
      "id": "cbe5e0e4-6531-461c-b78c-b4c0bd644060"
    },
