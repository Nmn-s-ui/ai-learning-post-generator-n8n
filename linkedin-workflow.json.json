        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.geminiBody) }}",
        "options": {}
      },
      "name": "Gemini Writes Pin Copy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        64,
        -176
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "id": "c7095db7-aa5a-45ea-9ae4-4cf976990b70",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ecvLkIKTYTe6JxJt",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const BOARD_ID = 'YOUR_PINTEREST_BOARD_ID';\nconst DISCLOSURE = '#affiliate #ad';\n\nconst product = $('Pick Next Product').first().json;\nlet text = $input.first().json.candidates[0].content.parts[0].text;\ntext = text.replace(/```json|```/g, '').trim();\nconst copy = JSON.parse(text);\n\nconst pinPayload = {\n  board_id: BOARD_ID,\n  link: product.affiliate_link,\n  title: String(copy.title).slice(0, 100),\n  description: (copy.description + ' ' + DISCLOSURE).slice(0, 800),\n  alt_text: String(copy.alt_text || copy.title).slice(0, 500),\n  media_source: { source_type: 'image_url', url: product.image_url }\n};\n\nreturn [{ json: { pinPayload } }];"
      },
